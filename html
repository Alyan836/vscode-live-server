<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>KhanaShare - For Donors</title>
  <link rel="stylesheet" href="styles.css" />
</head>
<body>
  <header>
    <h1>KhanaShare</h1>
    <nav>
      <ul>
        <li><a href="index.html">Home</a></li>
        <li><a href="donor.html">For Donors</a></li>
        <li><a href="recipient.html">For Recipients</a></li>
      </ul>
    </nav>
  </header>

  <section id="donor-interface">
    <h2>Donate Your Surplus Food</h2>
    <form id="donationForm">
      <label for="donorName">Your Name:</label>
      <input type="text" id="donorName" name="donorName" required />

      <label for="foodType">Food Type:</label>
      <input type="text" id="foodType" name="foodType" required />

      <label for="portionSize">Portion Size:</label>
      <input type="text" id="portionSize" name="portionSize" required />

      <label for="expiration">Expiration Date:</label>
      <input type="date" id="expiration" name="expiration" required />

      <label for="pickup">Pickup/Delivery:</label>
      <select id="pickup" name="pickup">
        <option value="pickup">Pickup</option>
        <option value="delivery">Delivery</option>
      </select>

      <label for="location">Your Location:</label>
      <input type="text" id="location" name="location" required />

      <button type="submit">Submit Donation</button>
    </form>
  </section>

  <footer>
    <p>&copy; 2025 KhanaShare. All rights reserved.</p>
  </footer>

  <script src="script.js"></script>
</body>
</html>
